<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark mode (the colours come from values-night/colors.xml) -->
    <style name="Base.AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <item name="android:statusBarColor">@color/accent</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="AppDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
