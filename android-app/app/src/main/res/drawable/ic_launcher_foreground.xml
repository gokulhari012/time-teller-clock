<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: the white clock of the settings page's tab icon. Inside the 66dp middle circle
     that every launcher shape keeps. The PNGs in mipmap-*dpi are the same clock for Android 5-7. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Clock face -->
    <path
        android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z"
        android:strokeWidth="5"
        android:strokeColor="#FFFFFF" />
    <!-- Hands -->
    <path
        android:pathData="M54,39V54L65,61.5"
        android:strokeWidth="5.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
