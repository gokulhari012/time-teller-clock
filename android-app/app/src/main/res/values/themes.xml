<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light mode. Dark mode is in values-night. -->
    <style name="Base.AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:alertDialogTheme">@style/AppDialog</item>
        <!-- The status bar is the blue of the page's header -->
        <item name="android:statusBarColor">@color/accent</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="AppDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
