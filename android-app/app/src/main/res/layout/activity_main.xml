<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Behind the status bar on Android 11+ (MainActivity.fitBetweenSystemBars sets its height) -->
    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/accent" />

    <FrameLayout
        android:id="@+id/screens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Screen 1: the steps -->
        <LinearLayout
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout style="@style/Header">

                <TextView
                    style="@style/HeaderTitle"
                    android:text="@string/app_name" />

                <TextView
                    style="@style/HeaderLine"
                    android:text="@string/header_subtitle" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="16dp">

                    <!-- Was the clock found? Colour, icon and text are set by MainActivity.showStatus -->
                    <LinearLayout
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rounded_box"
                        android:gravity="center_vertical"
                        android:minHeight="56dp"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp">

                            <ProgressBar
                                android:id="@+id/statusSpinner"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center" />

                            <ImageView
                                android:id="@+id/statusIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/circle"
                                android:importantForAccessibility="no"
                                android:padding="5dp"
                                android:visibility="gone" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/statusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/text"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- Step 1 -->
                    <LinearLayout style="@style/Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/StepNumber"
                                android:text="@string/step1_number" />

                            <TextView
                                style="@style/StepTitle"
                                android:text="@string/step1_title" />
                        </LinearLayout>

                        <TextView
                            style="@style/Body"
                            android:text="@string/step1_text" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Label"
                                android:text="@string/wifi_name_label" />

                            <TextView
                                style="@style/Value"
                                android:text="@string/wifi_name" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Label"
                                android:text="@string/wifi_password_label" />

                            <TextView
                                style="@style/Value"
                                android:text="@string/wifi_password" />
                        </LinearLayout>

                        <TextView
                            style="@style/Hint"
                            android:text="@string/step1_hint" />

                        <Button
                            android:id="@+id/wifiButton"
                            style="@style/AppButton.Secondary"
                            android:layout_marginTop="12dp"
                            android:text="@string/open_wifi_settings" />
                    </LinearLayout>

                    <!-- Step 2 -->
                    <LinearLayout style="@style/Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/StepNumber"
                                android:text="@string/step2_number" />

                            <TextView
                                style="@style/StepTitle"
                                android:text="@string/step2_title" />
                        </LinearLayout>

                        <TextView
                            style="@style/Body"
                            android:text="@string/step2_text" />

                        <TextView
                            style="@style/Hint"
                            android:text="@string/step2_hint" />

                        <Button
                            android:id="@+id/dataButton"
                            style="@style/AppButton.Secondary"
                            android:layout_marginTop="12dp"
                            android:text="@string/open_mobile_data" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Always visible at the bottom, like the page's Save bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/openButton"
                    style="@style/AppButton.Primary"
                    android:text="@string/open_clock" />

                <TextView
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Screen 2: the clock's settings page (the WebView is added by MainActivity.makeWebView) -->
        <FrameLayout
            android:id="@+id/webScreen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/webHolder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Covers the page until it has loaded; looks like the top of the page -->
            <LinearLayout
                android:id="@+id/pageLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <LinearLayout style="@style/Header">

                    <TextView
                        style="@style/HeaderTitle"
                        android:text="@string/app_name" />

                    <TextView
                        style="@style/HeaderLine"
                        android:text="@string/loading_page" />
                </LinearLayout>

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="48dp" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
